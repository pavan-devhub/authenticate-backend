# Copy this file to .env and fill in your details.
# .env is git-ignored, so your passwords never end up in version control.
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# The Gmail account that sends the verification codes.
# MAIL_PASSWORD is a 16-character Gmail app password, not your Google password.
# Turn on 2-Step Verification for the account, then create one at
# https://myaccount.google.com/apppasswords and paste it here without spaces.
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your16characterapppassword
